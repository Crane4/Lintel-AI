<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LintelAI.ViewModels"
             x:Class="LintelAI.Views.FileListView"
             x:DataType="vm:MainViewModel">

  <Border Classes="panel" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*">

      <!-- Search -->
      <TextBox Name="SearchBox" Grid.Row="0" Margin="12,12,12,8"
               Text="{Binding SearchText}"
               Watermark="Search files  (Ctrl+F)">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{x:Static vm:Icons.Search}" Width="14" Height="14" Margin="12,0,0,0"
                    Foreground="{DynamicResource InkMutedBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <!-- Filter + sort -->
      <StackPanel Grid.Row="1" Margin="10,0,10,10" Spacing="6">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="seg" Content="All" Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.All}" Classes.active="{Binding IsFilterAll}" />
          <Button Classes="seg" Content="High" Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.High}" Classes.active="{Binding IsFilterHigh}" />
          <Button Classes="seg" Content="Issues" Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.WithIssues}" Classes.active="{Binding IsFilterIssues}" />
          <Button Classes="seg" Content="Clean" Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.Clean}" Classes.active="{Binding IsFilterClean}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="seg" Command="{Binding ToggleSortCommand}"
                ToolTip.Tip="Change the sort order">
          <TextBlock Text="{Binding SortLabel}" />
        </Button>
      </Grid>

        <!-- Kind filters: press the active one again to clear it -->
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="seg" Command="{Binding ToggleKindFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.Vulnerability}"
                  Classes.active="{Binding IsFilterVulnerability}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static vm:Icons.Shield}" Width="12" Height="12" />
              <TextBlock Text="Vulnerabilities" />
              <TextBlock Text="{Binding VulnerabilityCount}" Classes="muted" />
            </StackPanel>
          </Button>
          <Button Classes="seg" Command="{Binding ToggleKindFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.Bug}"
                  Classes.active="{Binding IsFilterBug}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static vm:Icons.Bug}" Width="12" Height="12" />
              <TextBlock Text="Bugs" />
              <TextBlock Text="{Binding BugCount}" Classes="muted" />
            </StackPanel>
          </Button>
          <Button Classes="seg" Command="{Binding ToggleKindFilterCommand}"
                  CommandParameter="{x:Static vm:FileFilter.Smell}"
                  Classes.active="{Binding IsFilterSmell}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{x:Static vm:Icons.Wrench}" Width="12" Height="12" />
              <TextBlock Text="Smells" />
              <TextBlock Text="{Binding SmellCount}" Classes="muted" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <Border Grid.Row="1" Classes="hairline-b" VerticalAlignment="Bottom" Height="1" />

      <!-- List -->
      <Panel Grid.Row="2">
        <ListBox Classes="files"
                 ItemsSource="{Binding VisibleFiles}"
                 SelectedItem="{Binding SelectedFile}"
                 Margin="0,8,0,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItemViewModel">
              <Grid ColumnDefinitions="46,*,Auto" Margin="2,0,10,0" MinHeight="56" ToolTip.Tip="{Binding Path}">

                <!-- score / state -->
                <Panel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ScoreText}" IsVisible="{Binding HasScore}"
                             HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                             Classes.good="{Binding IsGood}"
                             Classes.fair="{Binding IsFair}"
                             Classes.poor="{Binding IsPoor}" />
                  <Ellipse Width="8" Height="8" Classes="pulse dot-wait" IsVisible="{Binding IsRunning}"
                           HorizontalAlignment="Center" />
                  <TextBlock Text="·" Classes="muted" FontSize="18" HorizontalAlignment="Center"
                             IsVisible="{Binding IsQueued}" />
                  <TextBlock Text="–" Classes="muted" FontSize="15" HorizontalAlignment="Center"
                             IsVisible="{Binding IsSkipped}" />
                  <TextBlock Text="!" Classes="poor" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"
                             IsVisible="{Binding IsFailed}" />
                </Panel>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Directory}" Classes="muted tiny" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasDirectory}" />
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                        IsVisible="{Binding HasIssues}"
                        Classes.sev-high="{Binding HasHighIssue}"
                        Classes.sev-low="{Binding !HasHighIssue}">
                  <TextBlock Text="{Binding IssueCount}" FontSize="11" FontWeight="SemiBold"
                             Classes.sev-high="{Binding HasHighIssue}"
                             Classes.sev-low="{Binding !HasHighIssue}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Nothing matches this filter." Classes="muted" HorizontalAlignment="Center"
                   VerticalAlignment="Center" IsVisible="{Binding NothingVisible}" />
      </Panel>

    </Grid>
  </Border>
</UserControl>
