<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LintelAI.ViewModels"
             xmlns:adv="using:LintelAI.Services.Security.Advanced"
             x:Class="LintelAI.Views.SidebarView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="*,Auto" Margin="20,24,20,20">

    <StackPanel Grid.Row="0" Spacing="24">

      <!-- What to do: review code quality, or check an unfamiliar project for malware -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
        <Button Grid.Column="0" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="Lint" Command="{Binding SetModeCommand}"
                CommandParameter="{x:Static vm:AppMode.Lint}"
                Classes.active="{Binding IsLintMode}"
                ToolTip.Tip="Review code quality with a model" />
        <Button Grid.Column="1" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="Scan" Command="{Binding SetModeCommand}"
                CommandParameter="{x:Static vm:AppMode.Scan}"
                Classes.active="{Binding IsScanMode}"
                ToolTip.Tip="Check an unfamiliar project for malicious code" />
      </Grid>

      <!-- Scan level: rules only, or rules plus a model that judges what they find -->
      <StackPanel Spacing="8" IsVisible="{Binding IsScanMode}">
        <TextBlock Classes="eyebrow" Text="SCAN LEVEL" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
          <Button Grid.Column="0" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Normal" Command="{Binding SetScanLevelCommand}" CommandParameter="{x:False}"
                  Classes.active="{Binding IsNormalScan}" />
          <Button Grid.Column="1" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Advanced" Command="{Binding SetScanLevelCommand}" CommandParameter="{x:True}"
                  Classes.active="{Binding IsAdvancedScan}" />
        </Grid>
        <TextBlock Classes="muted tiny" TextWrapping="Wrap" LineHeight="17" IsVisible="{Binding IsNormalScan}"
                   Text="Looks for known malicious patterns. Fast, and works offline with no model." />
        <TextBlock Classes="muted tiny" TextWrapping="Wrap" LineHeight="17" IsVisible="{Binding IsAdvancedScan}"
                   Text="The same scan, then your Ollama model reviews what it found. It can clear false alarms but never a high-severity one." />

        <!-- How much the model reads: more takes longer -->
        <StackPanel Spacing="8" IsVisible="{Binding IsAdvancedScan}" Margin="0,8,0,0">
          <TextBlock Classes="eyebrow" Text="DEPTH" />
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="2">
            <Button Grid.Column="0" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Quick" Command="{Binding SetScanDepthCommand}"
                    CommandParameter="{x:Static adv:AiDepth.Quick}"
                    Classes.active="{Binding IsDepthQuick}" />
            <Button Grid.Column="1" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Balanced" Command="{Binding SetScanDepthCommand}"
                    CommandParameter="{x:Static adv:AiDepth.Balanced}"
                    Classes.active="{Binding IsDepthBalanced}" />
            <Button Grid.Column="2" Classes="seg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Content="Thorough" Command="{Binding SetScanDepthCommand}"
                    CommandParameter="{x:Static adv:AiDepth.Thorough}"
                    Classes.active="{Binding IsDepthThorough}" />
          </Grid>
          <TextBlock Classes="muted tiny" TextWrapping="Wrap" LineHeight="17" Text="{Binding DepthHelp}" />
        </StackPanel>
      </StackPanel>

      <!-- Model: needed for code review and for the advanced scan -->
      <StackPanel Spacing="24" IsVisible="{Binding ShowModelPicker}">

      <!-- Model -->
      <StackPanel Spacing="8">
        <TextBlock Classes="eyebrow" Text="MODEL" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ComboBox Grid.Column="0"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding SelectedModel}"
                    PlaceholderText="No model available" />
          <Button Grid.Column="1" Classes="secondary icon" Width="38" Height="38"
                  Command="{Binding RefreshModelsCommand}"
                  ToolTip.Tip="Reload the list of models">
            <PathIcon Data="{x:Static vm:Icons.Refresh}" Width="15" Height="15" />
          </Button>
        </Grid>
      </StackPanel>

      <!-- Shown only when Ollama is not on this computer -->
      <Border IsVisible="{Binding ShowRemoteWarning}" Margin="0,-12,0,0" Padding="10,8" CornerRadius="8"
              Background="{DynamicResource FairSoftBrush}">
        <TextBlock TextWrapping="Wrap" Classes="small"
                   Text="This Ollama server is not on your computer. File contents are sent over the network to it." />
      </Border>

      </StackPanel>

      <!-- Project -->
      <StackPanel Spacing="8">
        <TextBlock Classes="eyebrow" Text="PROJECT" />
        <Button Classes="card" Command="{Binding BrowseCommand}" ToolTip.Tip="Choose a folder  (Ctrl+O)">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <PathIcon Grid.Column="0" Data="{x:Static vm:Icons.Folder}" Width="18" Height="18"
                      Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding FolderName}" IsVisible="{Binding HasFolder}"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FolderPath}" IsVisible="{Binding HasFolder}"
                         Classes="muted tiny" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="Choose a project folder" IsVisible="{Binding !HasFolder}"
                         Classes="soft" />
            </StackPanel>
          </Grid>
        </Button>
      </StackPanel>

      <!-- Run / stop -->
      <Panel>
        <Panel IsVisible="{Binding IsLintMode}">
          <Button Classes="primary" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsIdle}"
                  Command="{Binding StartCommand}"
                  ToolTip.Tip="Start  (F5)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Play}" Width="14" Height="14" />
              <TextBlock Text="Analyze project" />
            </StackPanel>
          </Button>
          <Button Classes="secondary" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsAnalyzing}"
                  Command="{Binding CancelCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Stop}" Width="13" Height="13" />
              <TextBlock Text="Stop" />
            </StackPanel>
          </Button>
        </Panel>

        <Panel IsVisible="{Binding IsScanMode}">
          <Button Classes="primary" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsIdle}"
                  Command="{Binding ScanCommand}"
                  ToolTip.Tip="Scan  (F5)">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Shield}" Width="14" Height="14" />
              <TextBlock Text="Scan project" />
            </StackPanel>
          </Button>
          <Button Classes="secondary" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsAnalyzing}"
                  Command="{Binding CancelCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static vm:Icons.Stop}" Width="13" Height="13" />
              <TextBlock Text="Stop" />
            </StackPanel>
          </Button>
        </Panel>
      </Panel>

      <!-- Progress -->
      <StackPanel Spacing="10" IsVisible="{Binding ShowProgress}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="eyebrow" Text="PROGRESS" />
          <TextBlock Grid.Column="1" Classes="small soft" Text="{Binding ProgressText}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
        <TextBlock Text="{Binding CurrentFile}" Classes="muted tiny mono" TextTrimming="CharacterEllipsis" />
      </StackPanel>

    </StackPanel>

    <!-- Footnote -->
    <Panel Grid.Row="1">
      <StackPanel Spacing="6" IsVisible="{Binding IsLintMode}">
        <TextBlock Classes="muted tiny" TextWrapping="Wrap" LineHeight="17">
          <Run Text="Skips node_modules, .git, bin, obj, dist, build and .env files. Add your own rules in a " />
          <Run Text=".AIIgnore" FontFamily="{StaticResource MonoFont}" />
          <Run Text=" file at the project root." />
        </TextBlock>
        <TextBlock Classes="muted tiny" IsVisible="{Binding HasIgnored}">
          <Run Text="{Binding IgnoredCount}" />
          <Run Text=" paths skipped by " />
          <Run Text=".AIIgnore" FontFamily="{StaticResource MonoFont}" />
        </TextBlock>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsScanMode}">
        <TextBlock Classes="muted tiny" TextWrapping="Wrap" LineHeight="17">
          <Run Text="Reads every file, including binaries and hidden ones. " />
          <Run Text=".AIIgnore" FontFamily="{StaticResource MonoFont}" />
          <Run Text=" is ignored on purpose: the project being checked doesn't get to hide files. Nothing is run, and nothing leaves this computer." />
        </TextBlock>
      </StackPanel>
    </Panel>

  </Grid>
</UserControl>
